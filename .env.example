# Salin file ini menjadi `.env.local` lalu isi sesuai kebutuhan.
# (.env.local tidak boleh di-commit — sudah ada di .gitignore)

# --- Supabase (backend: database, auth, storage) ---
# Cara ambil:
#   1. Buat proyek di https://supabase.com → New Project.
#   2. Project Settings → API → Project URL → copy ke NEXT_PUBLIC_SUPABASE_URL.
#   3. Project Settings → API → anon public key → copy ke NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Setup lanjutan (setelah isi key di atas) ---
# 1. Jalankan supabase/migrations/0001_init.sql di SQL Editor (buat tabel + RLS).
# 2. Authentication → Sign In / Up → aktifkan "Email" provider.
#    (Opsional) matikan "Confirm email" supaya registrasi langsung aktif.
# 3. Authentication → URL Configuration → Site URL: http://localhost:3000
#    supaya link konfirmasi email mengarah kembali ke aplikasi.
